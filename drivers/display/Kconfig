menuconfig DISPLAY
    bool "Display"
    help
      Display Drivers

if DISPLAY

config DISPLAY_SF32LB_LCDC
    bool "SiFli SF32LB LCD controller"
    default y
    depends on DT_HAS_SIFLI_SF32LB52_LCDC_ENABLED
    select CLK
    select PANEL
    select PINCTRL
    select RESET
    help
      Support for the SiFli SF32LB LCD controller, driving a JDI
      memory-in-pixel panel.

config DISPLAY_SF32LB_LCDC_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on DISPLAY_SF32LB_LCDC
    help
      Priority of the controller interrupt.

config DISPLAY_SF32LB57_LCDC
    bool "SiFli SF32LB57 LCD controller"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_LCDC_ENABLED
    select CLK
    select MIPI_DBI
    select PANEL
    select PINCTRL
    select RESET
    help
      Support for the SiFli SF32LB57 LCD controller, driving a panel with
      frame memory over quad SPI.

config DISPLAY_SF32LB57_LCDC_IRQ_PRIO
    int "Interrupt priority"
    default 0
    depends on DISPLAY_SF32LB57_LCDC
    help
      Priority of the controller interrupt.

choice DISPLAY_SF32LB57_LCDC_FORMAT
    prompt "Framebuffer format"
    default DISPLAY_SF32LB57_LCDC_FORMAT_ARGB2222
    depends on DISPLAY_SF32LB57_LCDC
    help
      Format of the framebuffers the display takes, whatever the one its
      panel is written in.

config DISPLAY_SF32LB57_LCDC_FORMAT_ARGB2222
    bool "ARGB2222"
    help
      8 bits per pixel, the Pebble color format.

config DISPLAY_SF32LB57_LCDC_FORMAT_RGB565
    bool "RGB565"
    help
      16 bits per pixel.

endchoice

config DISPLAY_SHARP_MEMORY
    bool "Sharp memory LCDs"
    default y
    depends on DT_HAS_SHARP_LS010B7DH04_ENABLED || \
               DT_HAS_SHARP_LS011B7DH03_ENABLED || \
               DT_HAS_SHARP_LS012B7DD01_ENABLED || \
               DT_HAS_SHARP_LS013B7DH01_ENABLED || \
               DT_HAS_SHARP_LS013B7DH03_ENABLED || \
               DT_HAS_SHARP_LS013B7DH05_ENABLED || \
               DT_HAS_SHARP_LS027B7DH01_ENABLED || \
               DT_HAS_SHARP_LS027B7DH01A_ENABLED || \
               DT_HAS_SHARP_LS044Q7DH01_ENABLED
    select GPIO
    select PWM
    select SPI
    help
      Support for the Sharp memory LCDs addressing their lines with 8 bits:
      LS010B7DH04, LS011B7DH03, LS012B7DD01, LS013B7DH01, LS013B7DH03,
      LS013B7DH05, LS027B7DH01, LS027B7DH01A and LS044Q7DH01.

config DISPLAY_SSD1677
    bool "Solomon SSD1677 e-paper controller"
    default y
    depends on DT_HAS_SOLOMON_SSD1677_ENABLED
    select GPIO
    select SPI
    help
      Support for the SSD1677 e-paper controller on SPI, with a
      data/command line and a BUSY input.

config DISPLAY_SSD1677_FRAME_COPY
    bool "SSD1677 keeps a copy of the frame shown"
    depends on DISPLAY_SSD1677
    default y
    help
      Keep the frame shown, and which of its pixels the fast refreshes
      changed, in RAM: twice the framebuffer's size. Without, the driver
      keeps a CRC per row, re-syncs the controller's planes from the
      framebuffer after each refresh, and tops up whole rows; text
      detail needs the copy.

config DISPLAY_SSD1677_DETAIL_CELLS
    int "SSD1677 framebuffer pixels drawn at panel resolution"
    depends on DISPLAY_SSD1677
    range 0 65535
    default TEXT_DETAIL_CELLS if TEXT_DETAIL
    default 0
    help
      Pixels of the frame shown whose detail (text edges, see struct
      pbl_display_detail) the driver keeps, at 2 bytes each, for a panel
      at twice the framebuffer's size; 0 for none. A frame with more
      draws the rows that do not fit as plain pixels.

config DISPLAY_SSD1677_GREY
    bool "SSD1677 4-level overlay (experimental)"
    depends on DISPLAY_SSD1677
    help
      pbl_display_ssd1677_grey(): the panel's 4-level overlay over a B/W
      image, as the X4's stock firmware draws anti-aliased text.

config DISPLAY_QEMU
    bool "QEMU Framebuffer Display"
    default y
    depends on DT_HAS_QEMU_PEBBLE_DISPLAY_ENABLED
    help
      Support for the QEMU framebuffer display peripheral.

config DISPLAY_QEMU_ESP_RGB
    bool "QEMU ESP RGB display"
    default y
    depends on DT_HAS_QEMU_ESP_RGB_ENABLED
    help
      Support for the RGB framebuffer of Espressif's QEMU machines.

config DISPLAY_SDL
    bool "SDL window"
    default y if SOC_POSIX
    select SDL
    help
      Display shown in an SDL window on the host of a native build.

if DISPLAY_SDL

config DISPLAY_SDL_WIDTH
    int "SDL display width"
    help
      Width of the SDL display, in pixels.

config DISPLAY_SDL_HEIGHT
    int "SDL display height"
    help
      Height of the SDL display, in pixels.

config DISPLAY_SDL_MONO
    bool "SDL display is monochrome"
    help
      The SDL display takes a 1-bit framebuffer, 8-bit color otherwise.

config DISPLAY_SDL_PANEL_SCALE
    int "SDL panel pixels per display pixel"
    range 1 2
    default 1
    help
      Show each display pixel as this many panel pixels in each
      direction, as a panel driven at twice the display's resolution
      does; at 2 the window also shows text detail at panel resolution.

config DISPLAY_SDL_ROUND
    bool "SDL display is round"
    help
      The SDL display hides the pixels outside the circle of the
      LS013B7DD02 panel.

endif # DISPLAY_SDL

config DISPLAY_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL
    help
      The display shell command, to show the display and turn its panel on
      or off.

module = DRIVER_DISPLAY
module-str = Display
source "subsys/logging/Kconfig.template.log_level"

endif # DISPLAY
