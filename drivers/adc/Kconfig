menuconfig ADC
    bool "ADCs"
    help
      Analog-to-digital converter class (pbl/drivers/adc.h), selected by the
      drivers that read analog inputs.

if ADC

config ADC_SHELL
    bool "Shell commands"
    default DRIVER_SHELL
    depends on SHELL && DEVICE_NAMES
    help
      The adc shell command, to list the ADCs and convert a channel.

config ADC_ESP32C3
    bool "Espressif ESP32-C3 SAR ADC"
    default y
    depends on DT_HAS_ESP_ESP32C3_ADC_ENABLED
    select PINCTRL
    help
      SAR ADC1 of the ESP32-C3, one-shot conversions of GPIO0 to GPIO4,
      with the factory calibration in its eFuse.

config ADC_SF32LB57_GPADC
    bool "SiFli SF32LB57 GPADC"
    default y
    depends on DT_HAS_SIFLI_SF32LB57_GPADC_ENABLED
    select CLK
    select NVMEM
    help
      General purpose ADC of the SiFli SF32LB57, read one channel at a
      time, with the factory calibration in its eFuse.

module = DRIVER_ADC
module-str = ADC
source "subsys/logging/Kconfig.template.log_level"

endif # ADC
