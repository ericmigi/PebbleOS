if SOC_ESP32S3

# The 4 MiB flash window mapped by the boot stub: data bus at 0x3c000000,
# instruction bus at 0x42000000.
config FLASH_BASE
    default 0x3c000000

config FLASH_SIZE
    default 0x400000

config XTENSA_CODE_ALIAS_OFFSET
    default 0x06000000

config NUM_IRQS
    default 99

# SRAM1: DRAM 0x3fc88000 maps to IRAM 0x40378000 (offset 0x6f0000).
config RAMFUNC_ALIAS_OFFSET
    default 0x6f0000

# Windowed ABI uses more stack space per ISR call frame than ARM/RISC-V.
config KERNEL_ISR_STACK_SIZE
    default 2048

# Build picolibc from source so time_t stays 32-bit and TLS is disabled.
config LIBC_PICOLIBC_FROM_SOURCE
    default y

endif # SOC_ESP32S3
