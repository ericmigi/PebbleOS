config SOC_ESP32S3_POWER_LATCH
    bool "Drive the power latch high at reset"
    default $(dt_has_nodelabel,power_latch)
    depends on SOC_ESP32S3
    help
      Drive the pin of the board's power_latch node high as the first
      thing early init does, before devices initialize, so a battery-powered
      board stays on once the power button is released.
