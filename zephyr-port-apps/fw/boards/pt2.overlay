/* SPDX-License-Identifier: Apache-2.0 */

&rtc {
	status = "okay";
};

/* Slot 0 base 0x12020000. pblboot's 28-byte header sits at the base and the
 * firmware body (vector table) begins at slot_base + 0x1000, matching pblboot
 * CONFIG_FIRMWARE_OFFSET=4096. Reserve that 0x1000 header page outside ROM. */
&gd25q256e {
	partitions {
		/delete-node/ partition@10000;

		slot0_code: partition@21000 {
			label = "slot0-code";
			reg = <0x21000 0x2ff000>;
		};
	};
};

/ {
	chosen {
		zephyr,code-partition = &slot0_code;
	};
};
