/dts-v1/;

// Xteink X4 e-reader: an ESP32-C3 (QFN32, 40 MHz crystal) with 16 MiB of flash in DIO mode, an
// 800x480 e-paper panel and a microSD slot on one SPI bus, keys on two ADC ladders, and a power
// latch that keeps the battery connected. The console is the USB-Serial-JTAG port: UART0's pins
// are the panel's chip select (GPIO21) and the USB detect input (GPIO20).

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/esp32c3-pinctrl.h>

#include "espressif/esp32c3.dtsi"

/ {
	model = "Xteink X4";
	compatible = "xteink,x4", "esp,esp32c3";

	chosen {
		stdout-path = &usb_serial_jtag;
	};

	// The battery reaches the board through a MOSFET this pin holds on: driven high from reset,
	// it keeps the board powered once the power button is released
	power_latch: regulator-latch {
		compatible = "regulator-fixed";
		regulator-name = "latch";
		gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	// A TP4056 with its status pins not connected: GPIO20 is high while USB is present, and the
	// battery reaches ADC channel 0 through two equal resistors
	charger: charger {
		compatible = "coredevices,adc-charger";
		gpios = <&gpio 20 GPIO_ACTIVE_HIGH>;
		io-channels = <&adc 0>;
		output-ohms = <10000>;
		full-ohms = <20000>;
	};

	// Six keys on two ladders that pull an ADC input down from about 3.3 V, the input clipping
	// at full scale with none pressed. Press voltages are the mean of those other X4 projects
	// measured; the nearest one wins, so each key's band ends halfway to its neighbour's. Key-up
	// is full scale as one unit's eFuse calibration reads it, 4095 x 1370 / 1851 mV.
	keys_a: adc-keys-a {
		compatible = "adc-keys";
		io-channels = <&adc 1>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <3030000>;
		poll-interval = <15>;

		button-back {
			label = "Back";
			linux,code = <KEY_BACK>;
			press-threshold-microvolt = <2600000>;
		};

		button-confirm {
			label = "Confirm";
			linux,code = <KEY_SELECT>;
			press-threshold-microvolt = <2000000>;
		};

		// Left and Right, side by side under the panel, as a second Up and Down
		button-left {
			label = "Left";
			linux,code = <KEY_UP>;
			press-threshold-microvolt = <1115000>;
		};

		button-right {
			label = "Right";
			linux,code = <KEY_DOWN>;
			press-threshold-microvolt = <0>;
		};
	};

	keys_b: adc-keys-b {
		compatible = "adc-keys";
		io-channels = <&adc 2>;
		io-channel-names = "buttons";
		keyup-threshold-microvolt = <3030000>;
		poll-interval = <15>;

		button-up {
			label = "Up";
			linux,code = <KEY_UP>;
			press-threshold-microvolt = <1670000>;
		};

		button-down {
			label = "Down";
			linux,code = <KEY_DOWN>;
			press-threshold-microvolt = <0>;
		};
	};

	// The side power key, active low with a pull-up on the board
	gpio-keys {
		compatible = "gpio-keys";

		button-power {
			label = "Power";
			gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_POWER>;
			debounce-interval = <20>;
		};
	};

	// 16 MiB SPI NOR (JEDEC ID 0x85 0x2018), of which the ROM maps the first 4 MiB for a direct boot
	flash0: flash@0 {
		compatible = "esp,esp32c3-flash";
		reg = <0x0 0x1000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			// Where the ROM boots from
			partition@0 {
				label = "code";
				reg = <0x0 0x400000>;
			};
		};
	};
};

&gpio {
	status = "okay";
};

&usb_serial_jtag {
	status = "okay";
};

// Channel 0 is the battery through a divider of two, 1 and 2 the key ladders; all at 11 dB
&adc {
	pinctrl-0 = <&adc_default>;
	pinctrl-names = "default";
	esp,attenuation = <3 3 3 3 3>;
	status = "okay";
};

&io_mux {
	// The battery (GPIO0, half the cell voltage) and the two key ladders (GPIO1, GPIO2): no
	// pulls, no input buffer. GPIO2 is a strapping pin, sampled only at reset.
	adc_default: adc-default-state {
		analog-pins {
			pinmux = <ESP32C3_PINMUX(0, ESP32C3_NOSIG, ESP32C3_NOSIG)>,
				 <ESP32C3_PINMUX(1, ESP32C3_NOSIG, ESP32C3_NOSIG)>,
				 <ESP32C3_PINMUX(2, ESP32C3_NOSIG, ESP32C3_NOSIG)>;
			bias-disable;
		};
	};

	spi2_default: spi2-default-state {
		// FSPICLK and FSPID out, through the GPIO matrix
		out-pins {
			pinmux = <ESP32C3_PINMUX(8, ESP32C3_NOSIG, 63)>,
				 <ESP32C3_PINMUX(10, ESP32C3_NOSIG, 65)>;
		};

		// FSPIQ in, the microSD card's only
		in-pins {
			pinmux = <ESP32C3_PINMUX(7, 64, ESP32C3_NOSIG)>;
			bias-pull-up;
		};
	};
};

// The panel and the microSD card share the bus: the card's chip select (GPIO12, free with the
// flash in DIO mode) is held high while there is no driver for it
&spi2 {
	pinctrl-0 = <&spi2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio 21 GPIO_ACTIVE_LOW>, <&gpio 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	// GDEQ0426T82 800x480 e-paper, mounted a quarter turn: 480x800 portrait, keys at the bottom
	display: display@0 {
		compatible = "solomon,ssd1677";
		reg = <0>;
		spi-max-frequency = <40000000>;
		dc-gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio 6 GPIO_ACTIVE_HIGH>;
		width = <480>;
		height = <800>;
		panel-width = <480>;
		panel-height = <800>;
		rotation = <270>;
		// 5 + 5 frames, 198 ms, against 21 frames, 416 ms, for the panel's own
		fast-frames = <5>;
	};
};
