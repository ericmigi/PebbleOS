/dts-v1/;

// Xteink X4 e-reader: an ESP32-C3 (QFN32, 40 MHz crystal) with 16 MiB of flash in DIO mode, an
// 800x480 e-paper panel and a microSD slot on one SPI bus, keys on two ADC ladders, and a power
// latch that keeps the battery connected. The console is the USB-Serial-JTAG port: UART0's pins
// are the panel's chip select (GPIO21) and the USB detect input (GPIO20).

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/pinctrl/esp32c3-pinctrl.h>

#include "espressif/esp32c3.dtsi"

/ {
	model = "Xteink X4";
	compatible = "xteink,x4", "esp,esp32c3";

	chosen {
		stdout-path = &usb_serial_jtag;
	};

	// The battery reaches the board through a MOSFET this pin holds on: driven high from reset,
	// it keeps the board powered once the power button is released
	power_latch: regulator-latch {
		compatible = "regulator-fixed";
		regulator-name = "latch";
		gpios = <&gpio 13 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	// 16 MiB SPI NOR (JEDEC ID 0x85 0x2018), of which the ROM maps the first 4 MiB for a direct boot
	flash0: flash@0 {
		compatible = "esp,esp32c3-flash";
		reg = <0x0 0x1000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			// Where the ROM boots from
			partition@0 {
				label = "code";
				reg = <0x0 0x400000>;
			};
		};
	};
};

&gpio {
	status = "okay";
};

&usb_serial_jtag {
	status = "okay";
};

&io_mux {
	spi2_default: spi2-default-state {
		// FSPICLK and FSPID out, through the GPIO matrix
		out-pins {
			pinmux = <ESP32C3_PINMUX(8, ESP32C3_NOSIG, 63)>,
				 <ESP32C3_PINMUX(10, ESP32C3_NOSIG, 65)>;
		};

		// FSPIQ in, the microSD card's only
		in-pins {
			pinmux = <ESP32C3_PINMUX(7, 64, ESP32C3_NOSIG)>;
			bias-pull-up;
		};
	};
};

// The panel and the microSD card share the bus: the card's chip select (GPIO12, free with the
// flash in DIO mode) is held high while there is no driver for it
&spi2 {
	pinctrl-0 = <&spi2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio 21 GPIO_ACTIVE_LOW>, <&gpio 12 GPIO_ACTIVE_LOW>;
	status = "okay";

	// GDEQ0426T82 800x480 e-paper, mounted a quarter turn: 480x800 portrait, keys at the bottom
	display: display@0 {
		compatible = "solomon,ssd1677";
		reg = <0>;
		spi-max-frequency = <10000000>;
		dc-gpios = <&gpio 4 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&gpio 5 GPIO_ACTIVE_LOW>;
		busy-gpios = <&gpio 6 GPIO_ACTIVE_HIGH>;
		width = <480>;
		height = <800>;
		panel-width = <480>;
		panel-height = <800>;
		rotation = <270>;
	};
};
