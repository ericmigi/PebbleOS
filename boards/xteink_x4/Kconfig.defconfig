# The firmware runs Flint on it, scaled up on the panel
config RESOURCES_BOARD
    default "qemu_flint"

# The radio, once CONFIG_ESP32C3_BT links Espressif's controller in
choice NIMBLE_HCI
    default NIMBLE_HCI_ESP32C3 if ESP32C3_BT
endchoice
