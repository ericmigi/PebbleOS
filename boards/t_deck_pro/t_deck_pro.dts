/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/esp32s3-pinctrl.h>
#include "espressif/esp32s3.dtsi"

/ {
	model = "LilyGO T-Deck Pro";
	compatible = "lilygo,t-deck-pro", "esp,esp32s3";

	chosen {
		stdout-path = &usb_serial_jtag;
	};

	i2c_periph: i2c {
		compatible = "i2c-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sda-gpios = <&gpio 13 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;
		scl-gpios = <&gpio 14 (GPIO_OPEN_DRAIN | GPIO_PULL_UP)>;

		keyboard@34 {
			compatible = "ti,tca8418";
			reg = <0x34>;
			interrupt-parent = <&gpio>;
			interrupts = <15 IRQ_TYPE_EDGE_FALLING>;
			keypad,num-rows = <4>;
			keypad,num-columns = <10>;
			// U, D, Backspace and Enter in the T-Deck Pro matrix.
			linux,keymap = <((0 << 24) | (6 << 16) | KEY_UP)
					((1 << 24) | (2 << 16) | KEY_DOWN)
					((1 << 24) | (9 << 16) | KEY_BACK)
					((2 << 24) | (9 << 16) | KEY_SELECT)>;
		};
	};

	flash0: flash@0 {
		compatible = "esp,esp32s3-flash";
		reg = <0 0x1000000>;
	};
};

&gpio {
	status = "okay";
};

&usb_serial_jtag {
	status = "okay";
};

&io_mux {
	spi2_default: spi2-default-state {
		out-pins {
			pinmux = <ESP32S3_PINMUX(36, ESP32S3_NOSIG, ESP32S3_SIG_FSPICLK)>,
				 <ESP32S3_PINMUX(33, ESP32S3_NOSIG, ESP32S3_SIG_FSPID)>;
		};
	};
};

&spi2 {
	pinctrl-0 = <&spi2_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio 34 GPIO_ACTIVE_LOW>;
	status = "okay";

	display: display@0 {
		compatible = "ultrachip,uc8253";
		reg = <0>;
		spi-max-frequency = <4000000>;
		dc-gpios = <&gpio 35 GPIO_ACTIVE_HIGH>;
		busy-gpios = <&gpio 37 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		// Leave the other devices on the shared bus deselected.
		sd-select-gpios = <&gpio 48 GPIO_ACTIVE_LOW>;
		radio-select-gpios = <&gpio 3 GPIO_ACTIVE_LOW>;
		width = <240>;
		height = <320>;
	};
};

&cpu0 {
	clock-frequency = <240000000>;
};

&clk_apb {
	clock-frequency = <80000000>;
};
