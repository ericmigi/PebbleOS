// Flint's 144x168, three times as large on the 480x800 panel
&display {
	width = <144>;
	height = <168>;
	scale = <3>;
};

&flash0 {
	reg = <0x0 0x1000000>;

	partitions {
		/delete-node/ partition@0;

#include "esp32c3-flash-16m.dtsi"
	};
};
