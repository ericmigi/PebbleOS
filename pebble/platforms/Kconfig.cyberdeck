if PLATFORM_CYBERDECK

config PLATFORM_NAME
    default "cyberdeck"

config PLATFORM_DISPLAY_WIDTH
    default 400

config PLATFORM_DISPLAY_HEIGHT
    default 240

config PLATFORM_MICROPHONE
    default y

config PLATFORM_HEALTH
    default y

config PLATFORM_SPEAKER
    default y

# Legacy apps get the whole display rather than a 144x168 window.

config PLATFORM_LEGACY_2X_DISPLAY_WIDTH
    default 400

config PLATFORM_LEGACY_2X_DISPLAY_HEIGHT
    default 240

config PLATFORM_LEGACY_3X_DISPLAY_WIDTH
    default 400

config PLATFORM_LEGACY_3X_DISPLAY_HEIGHT
    default 240

# RAM of an app and of its runtime.

config APP_RAM_4X_SEGMENT_SIZE
    default 67584

config APP_RAM_4X_RUNTIME_SIZE
    default 30720

endif # PLATFORM_CYBERDECK
