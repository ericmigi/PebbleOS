if PLATFORM_FOLIO

config PLATFORM_NAME
    default "folio"

config PLATFORM_DISPLAY_WIDTH
    default 240

config PLATFORM_DISPLAY_HEIGHT
    default 400

# RAM of an app and of its runtime.

config APP_RAM_4X_SEGMENT_SIZE
    default 67584

config APP_RAM_4X_RUNTIME_SIZE
    default 30720

# Glyphs at panel resolution, 2 bits per pixel, for the system UI's text are up to 8x larger

config PLATFORM_MAX_FONT_GLYPH_SIZE
    default 1088

endif # PLATFORM_FOLIO
