config SAMSA
    bool "Run third-party apps with the Samsa Thumb-2 interpreter"
    depends on !CPU_CORTEX_M
    # The thunks are generated from the SDK built for apps.
    select REQUIRES_ARM_TOOLCHAIN
    select UZLIB
    help
      Interpret the ARM code of third-party apps and workers with Samsa,
      so a native build can install and run .pbw files.

if SAMSA

# What the interpreter keeps per process for the firmware objects apps see.
# The defaults suit a 64-bit host, where objects with pointers are twice the
# size an app expects; a small target trades them for RAM.

config SAMSA_APP_SCRATCH_SIZE
    int "App scratch for the app's views of firmware objects (bytes)"
    default 262144

config SAMSA_APP_ARENA_SIZE
    int "App arena for host copies of app objects (bytes)"
    default 262144

config SAMSA_WORKER_SCRATCH_SIZE
    int "Worker scratch (bytes)"
    default 32768

config SAMSA_WORKER_ARENA_SIZE
    int "Worker arena (bytes)"
    default 32768

config SAMSA_MAX_HANDLES
    int "Firmware objects a process can address"
    default 4096

config SAMSA_HOST_STACK_SIZE
    int "Stack of the interpreter and the firmware it calls (bytes)"
    depends on !SOC_POSIX
    default 8192
    help
      On a firmware, the task of a process Samsa runs gets this stack in
      the process's RAM, besides the stack its ARM code runs on.

config SAMSA_MAX_OBJS
    int "Converted objects a process can have"
    default 1024

config SAMSA_CACHE_ENTRIES
    int "Decoded instructions a process keeps"
    range 0 1024
    default 0
    help
      Thumb instructions kept decoded per process, by address: a power of
      two, or 0 to decode every instruction each time it runs. Each entry
      takes about 12 bytes of each process's interpreter state.

config SAMSA_RAMFUNC
    bool "Run the interpreter's hot path from RAM"
    depends on RAMFUNC
    help
      Link the code Samsa runs on every interpreted instruction (its loop,
      the common instruction handlers and their helpers, about 7 KiB)
      into RAM, for SoCs that run code in place from flash through a small
      cache, where the interpreter otherwise waits on cache misses. Costs
      that much RAM.

module = SAMSA
module-str = Samsa
source "subsys/logging/Kconfig.template.log_level"

endif
